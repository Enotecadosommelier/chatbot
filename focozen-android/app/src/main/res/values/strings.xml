<resources>
    <string name="app_name">FocoZen</string>
    <string name="accessibility_service_label">FocoZen — Bloqueio de apps</string>
    <string name="accessibility_service_description">Permite que o FocoZen detecte quando você abre um app bloqueado e mostre a tela de fricção. O FocoZen não lê o conteúdo da tela, textos digitados ou dados pessoais — apenas o nome do app em primeiro plano.</string>

    <!-- Onboarding -->
    <string name="onboarding_usage_title">Ver quanto tempo você usa cada app</string>
    <string name="onboarding_usage_desc">O FocoZen precisa de acesso às estatísticas de uso do sistema para montar seu relatório de tempo de tela e mostrar quais apps mais consomem o seu foco. Esses dados ficam só no seu aparelho.</string>
    <string name="onboarding_overlay_title">Mostrar a tela de pausa na hora certa</string>
    <string name="onboarding_overlay_desc">Para exibir uma tela de fricção quando você abrir um app bloqueado, o FocoZen precisa da permissão de sobreposição (aparecer por cima de outros apps).</string>
    <string name="onboarding_accessibility_title">Detectar quando um app bloqueado é aberto</string>
    <string name="onboarding_accessibility_desc">O serviço de acessibilidade avisa o FocoZen quando você troca de app, para saber se deve mostrar a tela de bloqueio. Nenhum conteúdo de tela é lido ou armazenado.</string>
    <string name="onboarding_action_open_settings">Abrir configuração</string>
