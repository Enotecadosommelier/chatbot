<?xml version="1.0" encoding="utf-8"?>
<!--
    Configuração do serviço de acessibilidade do FocoZen.

    eventTypes="typeWindowStateChanged": só escutamos troca de janela/app em primeiro plano,
    o mínimo necessário para saber "qual app o usuário abriu agora". Não habilitamos captura de
    conteúdo de tela (não usamos canRetrieveWindowContent para leitura de texto, apenas para
    obter o nome do pacote da janela ativa).

    notificationTimeout curto para reagir rápido quando o usuário abre um app bloqueado.
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagReportViewIds|flagRetrieveInteractiveWindows"
    android:canRetrieveWindowContent="true"
    android:description="@string/accessibility_service_description"
    android:notificationTimeout="100"
    android:settingsActivity="com.focozen.app.MainActivity" />
